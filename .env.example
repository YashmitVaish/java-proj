# copy to .env and fill in. .env is git-ignored.
# Anything not set here falls back to src/main/resources/application.properties.

# random 32+ chars, e.g. `openssl rand -base64 64 | tr -d '\n'`   (required)
JWT_SECRET=

# optional
# DB_PATH=khata.db
# SERVER_PORT=8080
# JWT_EXPIRATION_HOURS=24
# CORS_ALLOWED_ORIGINS=http://localhost:3000
