# copy to .env and fill in. .env is git-ignored.

# supabase -> project settings -> database -> connection string (direct or session pooler, port 5432)
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# random string, at least 32 characters. e.g. `openssl rand -base64 64 | tr -d '\n'`
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# comma separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_PORT=8080
